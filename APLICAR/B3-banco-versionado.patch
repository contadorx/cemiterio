+  else
+    update walkstamp.roteiro_caso
+       set feito_em = now(), feito_por = e,
+           arquivo   = nullif(btrim(coalesce(p_arquivo,'')),''),
+           impressao = nullif(btrim(coalesce(p_impressao,'')),''),
+           observacao= nullif(btrim(coalesce(p_observacao,'')),''),
