# =============================================================================
# SUREYA — variáveis de ambiente
#
# Copie para `.env.local` e preencha. O `.gitignore` já protege `.env*`.
#
# REGRA DO BUILD 0: três ambientes SEPARADOS — desenvolvimento, homologação e
# produção — cada um com seu projeto Supabase e sua instância de WhatsApp.
# Nenhuma chave de produção pode aparecer no ambiente de ensaio: o ensaio manda
# mensagem de verdade se a Evolution apontar para a linha real.
#
# `src/lib/env.ts` falha cedo (throw) quando falta uma variável obrigatória —
# é melhor não subir do que subir pela metade.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# As duas primeiras vão para o navegador. São públicas por natureza: é por isso
# que a autorização real precisa estar em RLS no banco, não no `exigirAdmin()`
# das rotas (Build 1).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUNCA no navegador. Ignora RLS por completo.
SUPABASE_SERVICE_ROLE_KEY=

# --- Identidade da operação --------------------------------------------------
# Hoje o sistema é uma organização só; o webhook usa esta org fixa.
SUREYA_ORG_ID=

# --- WhatsApp (Evolution API) ------------------------------------------------
# Em homologação, aponte para uma instância de TESTE. Com a instância de
# produção aqui, o ensaio manda mensagem para famílias reais.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Segredo que a Evolution envia no webhook.
# A auditoria (P1) pede para parar de aceitar este segredo por query string e
# passar a header assinado com timestamp/HMAC.
SUREYA_WEBHOOK_SECRET=

# --- Crons (Vercel) ----------------------------------------------------------
# A Vercel envia `Authorization: Bearer <CRON_SECRET>`.
# Mesmo P1 acima: só header, nunca query string.
CRON_SECRET=

# --- IA ----------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Validar o modelo no ambiente antes de subir (achado P2 da auditoria).
ANTHROPIC_MODEL=claude-sonnet-5

# Transcrição de áudio — opcionais, usa o primeiro disponível.
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Push (Web Push / VAPID) -------------------------------------------------
# Gere o par com:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@seudominio.com.br

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br
NEXT_PUBLIC_MAPA_TILES=

# --- Ajustes opcionais -------------------------------------------------------
# Celular que recebe aviso de lead novo (só dígitos, com 55 na frente).
SUREYA_AVISO_WHATSAPP=
# Janela de agrupamento de rajadas de mensagem, em segundos.
SUREYA_DEBOUNCE_SEGUNDOS=20
# Score mínimo para resposta automática em assunto rotineiro (0-100).
SUREYA_SCORE_LIMITE_AUTO=80
