+  /* ---- A FILEIRA DE AÇÕES DO CARTÃO ----
+
+     Eram três botões flutuando POR CIMA da imagem, com `opacity:0` até o mouse
+     chegar. Três defeitos, e o terceiro é o grave:
+
+     1. num aparelho de toque não existe `:hover`. A lente — onde moram tarja,
+        recorte, comparação, troca de imagem, clipe e a fala — ficava
+        inalcançável, e nada na tela dizia que ela existe;
+     2. a seta desabilitada era `opacity:0 !important`. Nas pontas da fileira o
+        controle não ficava apagado: ele sumia, e quem está no primeiro quadro
+        conclui que a ferramenta não move quadros;
+     3. o botão se chamava "Ampliar" e desenhava uma lupa. Quem procura onde
+        tapar um CPF não procura dentro de uma lupa — procura em `Editar`.
+
+     Agora é uma fileira de verdade, sempre visível, no pé do cartão, com o nome
+     do lugar escrito por extenso. O custo é ~24 px de altura por cartão; o que
+     ele compra é a única porta para metade das funções da ferramenta. */
+  .thumbs .acoes{display:flex;gap:4px;align-items:center;justify-content:center;
+      padding:5px 5px 6px;border-top:1px solid var(--line)}
+  .thumbs .acoes button{border:1px solid var(--line);background:var(--panel);
+      color:var(--ink);cursor:pointer;border-radius:6px;padding:0;line-height:1;
+      font-family:inherit}
+  .thumbs .editar{flex:1;min-width:0;height:24px;font-size:11px;font-weight:600;
+      overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+  .thumbs .editar:hover{border-color:var(--accent);color:var(--accent)}
+  .thumbs .mover{width:24px;height:24px;font-size:13px;flex:0 0 auto}
+  .thumbs .mover:hover:not(:disabled){border-color:var(--accent);color:var(--accent)}
+  /* Desabilitada, e VISÍVEL. Ver o controle apagado responde "não há para onde
+     mover"; não ver controle nenhum responde "isto não existe". */
+  .thumbs .mover:disabled{opacity:.32;cursor:default}
+  .thumbs .acoes button:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
+  /* Um quadro descartado não tem o que editar nem para onde ir. A fileira fica
+     no lugar, vazia: escondê-la mudaria a altura do cartão e desalinharia a
+     grade a cada descarte — o mesmo motivo pelo qual a legenda mantém o traço
+     no lugar do número. */
+  .thumbs figure.off .acoes{visibility:hidden}
+  /* ---- A PRIMEIRA LINHA DA FALA ----
+
+     O essencial que faltava no cartão. Numa gravação de quarenta telas de
+     sistema as imagens são quase idênticas — mesma janela, mesmo menu — e o
+     instante não distingue nada: `04:12` e `04:31` são o mesmo nada. O que
+     distingue é o que estava sendo dito ali. Duas linhas no máximo; o texto
+     inteiro, editável, continua em `Editar`. */
+  .thumbs figcaption .fala{display:-webkit-box;-webkit-line-clamp:2;
+      -webkit-box-orient:vertical;overflow:hidden;margin-top:4px;text-align:left;
+      /* Padding próprio: a legenda não tem nenhum na horizontal, e nunca
+         precisou — número e relógio são curtos e centrados. Uma frase alinhada
+         à esquerda sem isto encosta na borda do cartão. */
+      padding:0 6px;
+      /* E a fonte do texto, não a monoespaçada da legenda. O relógio e o
